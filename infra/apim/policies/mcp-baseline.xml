<policies>
    <inbound>
        <base />
        <!-- Invariant base: auth + backend routing (never removed by beat toggles) -->
        <include-fragment fragment-id="santa-mcp-base" />
        <set-header name="x-functions-key" exists-action="override">
            <value>{{__KEY_NV__}}</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
